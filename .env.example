# PostgreSQL. Local: `docker compose up -d` and keep the values below.
# Neon/Vercel: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooler) one.
DATABASE_URL="postgresql://redshot:redshot@localhost:5432/redshot"
DIRECT_URL="postgresql://redshot:redshot@localhost:5432/redshot"

# WhatsApp number that receives bookings (digits only, with country code)
WHATSAPP_NUMBER=996506056556

# Admin password as a bcrypt hash. Generate with: npm run hash-password -- <password>
# IMPORTANT: escape every `$` as `\$` (Next.js expands $VARS in .env files).
ADMIN_PASSWORD_HASH=\$2b\$12\$replace.with.your.own.bcrypt.hash.................

# Secret for signing admin JWT sessions (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site URL (used for SEO / Open Graph / sitemap)
SITE_URL=http://localhost:3000
