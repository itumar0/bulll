# Database (SQLite for dev/small VPS). For PostgreSQL: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# WhatsApp number that receives bookings (digits only, with country code)
WHATSAPP_NUMBER=996506056556

# Admin password as a bcrypt hash. Generate with: npm run hash-password -- <password>
# IMPORTANT: escape every `$` as `\$` (Next.js expands $VARS in .env files).
ADMIN_PASSWORD_HASH=\$2b\$12\$replace.with.your.own.bcrypt.hash.................

# Secret for signing admin JWT sessions (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site URL (used for SEO / Open Graph / sitemap)
SITE_URL=http://localhost:3000
